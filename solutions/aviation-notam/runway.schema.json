{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "szh-notam-runway-paper-v1",
  "title": "跑道五字段（论文附录 v1）",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["airport", "runway", "affect_actype", "affect_region", "flight_type"],
    "properties": {
      "airport": { "type": "string", "pattern": "^[A-Z]{4}$", "description": "机场ICAO代码" },
      "runway": { "type": "string", "pattern": "^(0[1-9]|[12][0-9]|3[0-6])[LRC]?$", "description": "单个跑道方向编号" },
      "affect_actype": { "type": ["string", "null"], "description": "受影响机型或条件，未提及时为null" },
      "affect_region": { "enum": ["TAKEOFFS", "LANDINGS", "TAKEOFFS,LANDINGS"] },
      "flight_type": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}
