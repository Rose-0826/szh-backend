{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "szh-notam-report-v1",
  "title": "研究报告业务解析（保留案例字段；时间信息为工程补充）",
  "type": "object",
  "required": ["airport", "restriction_Type"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "airport": {"type": "string", "pattern": "^[A-Z]{4}$"},
    "restriction_Type": {"enum": ["closed", "ltd", "open"]},
    "affect_region": {"enum": ["TAKEOFFS", "LANDINGS", "TAKEOFFS,LANDINGS"]},
    "Diversion_Restriction": {"type": "boolean"},
    "industrialaction": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "details": {"type": "string", "minLength": 1},
    "exception": {"type": "string", "minLength": 1},
    "aip_reference": {"type": "string", "minLength": 1},
    "restrictions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["applies_to", "permission", "operation"],
        "properties": {
          "applies_to": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
            "flight_type": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["international", "domestic", "regional"]}},
            "aircraft_type": {"type": "string", "minLength": 1}
          }},
          "permission": {"enum": ["denied", "conditional", "allowed"]},
          "operation": {"enum": ["landing", "takeoff", "takeoff,landing", "diversion"]},
          "condition": {"type": "string", "minLength": 1}
        },
        "allOf": [{"if": {"properties": {"permission": {"const": "conditional"}}}, "then": {"required": ["condition"]}}]
      }
    },
    "affected_facilities": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["type", "name", "status"], "additionalProperties": false, "properties": {
        "type": {"enum": ["Runway", "Taxiway", "Airport"]},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["closed", "restricted", "open"]}
      }}
    },
    "validity": {
      "type": "object", "required": ["start", "end", "permanent", "estimated", "schedule"], "additionalProperties": false,
      "properties": {
        "start": {"type": ["string", "null"], "pattern": "^\\d{10}$"},
        "end": {"type": ["string", "null"], "pattern": "^\\d{10}$"},
        "permanent": {"type": "boolean"},
        "estimated": {"type": "boolean"},
        "schedule": {"type": ["string", "null"]}
      }
    }
  }
}
