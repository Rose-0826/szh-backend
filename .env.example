# Copy to .env only for DSH model settings. Keep credentials outside Git.
SZH_MODEL_PROVIDER=deepseek-official
SZH_MODEL_BASE_URL=https://api.deepseek.com/anthropic
SZH_MODEL=deepseek-flash
SZH_MODEL_API_KEY=
SZH_MODEL_REASONING_EFFORT=max
# Optional path to a private DSH configuration file. Set in the process environment.
# SZH_MODEL_ENV_FILE=

# The following settings are read from the process environment, not .env.
# SZH_PORT=4782
# SZH_AIC_MATERIALS=
# SZH_AIC_PYTHON=
# SZH_AIC_PACKAGE=
# SZH_AIC_MODEL_PACKAGE_URL=
# SZH_SERVICE_URL=http://127.0.0.1:4782
